<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TriangleNet.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scenarios of the characterization tests (same workloads that are pinned by golden fingerprints). -->
    <Compile Include="..\Triangle.Tests\Characterization\MeshCases.cs" Link="Characterization\MeshCases.cs" />
    <Compile Include="..\Triangle.Tests\Corpus\CorpusCase.cs" Link="Corpus\CorpusCase.cs" />
    <None Include="..\Triangle.Tests\Characterization\Data\*.txt" Link="Characterization\Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Triangle\Triangle.csproj" />
  </ItemGroup>

</Project>
